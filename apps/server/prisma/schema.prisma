// Full data model of milestone 1. Written in one piece on purpose: the schema dictates the
// contracts of specs 002, 003 and 004, and splitting it would mean rewriting migrations
// three times. See docs/specs/002-data-model-and-auth.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id
  username     String   @unique
  displayName  String
  passwordHash String
  email        String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     RefreshSession[]
  memberships  Member[]
  ownedServers Server[]         @relation("ServerOwner")
  messages     Message[]
  invites      Invite[]

  contactSettings      UserContactSettings?
  requestedFriendships FriendRequest[]          @relation("FriendRequestRequester")
  friendRequestsAsLow  FriendRequest[]          @relation("FriendRequestLowUser")
  friendRequestsAsHigh FriendRequest[]          @relation("FriendRequestHighUser")
  friendshipsAsLow     Friendship[]             @relation("FriendshipLowUser")
  friendshipsAsHigh    Friendship[]             @relation("FriendshipHighUser")
  blocksCreated        UserBlock[]              @relation("Blocker")
  blocksReceived       UserBlock[]              @relation("Blocked")
  conversationsAsLow   DirectConversation[]     @relation("DirectConversationLowUser")
  conversationsAsHigh  DirectConversation[]     @relation("DirectConversationHighUser")
  directReads          DirectConversationRead[]
  callsStarted         DirectCall[]             @relation("DirectCallCaller")
  callsReceived        DirectCall[]             @relation("DirectCallCallee")
  callsEnded           DirectCall[]             @relation("DirectCallEndedBy")

  @@map("users")
}

enum ContactAudience {
  EVERYONE
  FRIENDS
  NOBODY
}

model UserContactSettings {
  userId                String          @id
  directMessageAudience ContactAudience @default(EVERYONE)
  directCallAudience    ContactAudience @default(EVERYONE)
  friendRequestAudience ContactAudience @default(EVERYONE)
  updatedAt             DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_contact_settings")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model FriendRequest {
  id          String              @id
  userLowId   String
  userHighId  String
  requesterId String
  status      FriendRequestStatus
  createdAt   DateTime            @default(now())
  resolvedAt  DateTime?

  userLow   User @relation("FriendRequestLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh  User @relation("FriendRequestHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  requester User @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([userLowId, status])
  @@index([userHighId, status])
  @@map("friend_requests")
}

model Friendship {
  id         String   @id
  userLowId  String
  userHighId String
  createdAt  DateTime @default(now())

  userLow  User @relation("FriendshipLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("FriendshipHighUser", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@map("friendships")
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model DirectConversation {
  id         String   @id
  userLowId  String
  userHighId String
  createdAt  DateTime @default(now())

  userLow  User                     @relation("DirectConversationLowUser", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User                     @relation("DirectConversationHighUser", fields: [userHighId], references: [id], onDelete: Cascade)
  messages Message[]
  reads    DirectConversationRead[]
  calls    DirectCall[]

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@map("direct_conversations")
}

enum DirectCallStatus {
  RINGING
  ACTIVE
  DECLINED
  CANCELLED
  MISSED
  ENDED
}

model DirectCall {
  id                String           @id
  conversationId    String
  callerId          String
  calleeId          String
  callerSessionId   String
  clientNonce       String
  status            DirectCallStatus
  answeredSessionId String?
  historyMessageId  String?          @unique
  createdAt         DateTime         @default(now())
  answeredAt        DateTime?
  endedAt           DateTime?
  endedById         String?

  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller         User               @relation("DirectCallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee         User               @relation("DirectCallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  endedBy        User?              @relation("DirectCallEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  historyMessage Message?           @relation("DirectCallHistoryMessage", fields: [historyMessageId], references: [id], onDelete: SetNull)

  @@unique([callerSessionId, clientNonce])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([calleeId, status, createdAt(sort: Desc)])
  @@index([callerId, status, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("direct_calls")
}

model DirectConversationRead {
  conversationId    String
  userId            String
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastRead     Message?           @relation("DirectConversationLastRead", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@id([conversationId, userId])
  @@index([userId, updatedAt])
  @@index([lastReadMessageId])
  @@map("direct_conversation_reads")
}

/// One long-lived login on one device. The token itself is never stored — only its
/// SHA-256 — so a database dump cannot be replayed as a session.
model RefreshSession {
  id        String    @id
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}

model Server {
  id        String   @id
  name      String
  ownerId   String
  iconUrl   String?
  createdAt DateTime @default(now())

  owner      User       @relation("ServerOwner", fields: [ownerId], references: [id])
  roles      Role[]
  members    Member[]
  categories Category[]
  channels   Channel[]
  invites    Invite[]

  @@index([ownerId])
  @@map("servers")
}

/// Permissions are a bitmask, not rows: the check runs on every message and every channel
/// listing, so it has to be arithmetic on a number rather than a query.
model Role {
  id          String   @id
  serverId    String
  name        String
  color       Int      @default(0)
  permissions BigInt   @default(0)
  position    Int      @default(0)
  /// The @everyone role. Exactly one per server, created together with the server.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  server    Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members   MemberRole[]
  overrides ChannelOverride[]

  @@unique([serverId, name])
  @@index([serverId, position])
  @@map("roles")
}

model Member {
  id       String   @id
  serverId String
  userId   String
  nickname String?
  joinedAt DateTime @default(now())

  server    Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MemberRole[]
  overrides ChannelOverride[]
  reads     ChannelRead[]

  @@unique([serverId, userId])
  @@index([userId])
  @@map("members")
}

model MemberRole {
  memberId String
  roleId   String

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
  @@map("member_roles")
}

model Category {
  id       String @id
  serverId String
  name     String
  position Int    @default(0)

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@index([serverId, position])
  @@map("categories")
}

enum ChannelType {
  TEXT
  VOICE
}

model Channel {
  id         String      @id
  serverId   String
  categoryId String?
  type       ChannelType
  name       String
  topic      String?
  position   Int         @default(0)
  createdAt  DateTime    @default(now())

  server    Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages  Message[]
  overrides ChannelOverride[]
  reads     ChannelRead[]

  @@index([serverId, position])
  @@index([categoryId, position])
  @@map("channels")
}

/// Third step of permission resolution: a per-channel patch on top of the roles a member
/// already has. Exactly one of roleId / memberId is set.
model ChannelOverride {
  id        String  @id
  channelId String
  roleId    String?
  memberId  String?
  allow     BigInt  @default(0)
  deny      BigInt  @default(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId])
  @@unique([channelId, memberId])
  @@index([channelId])
  @@map("channel_overrides")
}

/// The payload is bytes, not text, and that is deliberate: today it holds UTF-8 JSON, and
/// when end-to-end encryption lands in M7 it holds ciphertext without migrating the column
/// or the history in it. `contentSchema` says how to read those bytes. Everything needed to
/// paginate, thread and count unread lives in separate columns and stays readable.
model Message {
  id                   String    @id
  channelId            String?
  directConversationId String?
  authorId             String
  content              Bytes
  contentSchema        String    @default("text/v1")
  replyToId            String?
  clientNonce          String?
  createdAt            DateTime  @default(now())
  editedAt             DateTime?
  deletedAt            DateTime?

  channel            Channel?                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  directConversation DirectConversation?      @relation(fields: [directConversationId], references: [id], onDelete: Cascade)
  author             User                     @relation(fields: [authorId], references: [id])
  replyTo            Message?                 @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[]                @relation("MessageReply")
  directReadMarks    DirectConversationRead[] @relation("DirectConversationLastRead")
  callHistory        DirectCall?              @relation("DirectCallHistoryMessage")

  @@unique([directConversationId, authorId, clientNonce])
  // Cursor pagination of channel history walks this index backwards. Never OFFSET.
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([directConversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("messages")
}

/// How far a member has read a channel. Unread is "messages newer than this mark", counted
/// for every channel of a server in one grouped query rather than one query per channel.
model ChannelRead {
  memberId          String
  channelId         String
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([memberId, channelId])
  @@index([channelId])
  @@map("channel_reads")
}

model Invite {
  id          String    @id
  code        String    @unique
  serverId    String
  createdById String
  maxUses     Int?
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("invites")
}
