# Copy to .env before the first run. .env itself is never committed.

# --- server ---
NODE_ENV=development
PORT=3000
# Origin the browser client is served from, used for the CORS allowlist.
CORS_ORIGIN=http://localhost:5173

# Signs access tokens. Must be at least 32 characters and must differ per install:
# every token ever signed with a leaked secret stays forgeable.
JWT_SECRET=change-me-to-32-plus-random-characters
# Access token lifetime, seconds. Short by design: it cannot be revoked, only outlived.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# How long a resolved permission answer is reused, in seconds.
PERMISSION_CACHE_TTL=60

# Reverse proxies in front of the server, 0 when it is exposed directly. Rate limiting keys
# on the client address, and behind nginx every request otherwise looks like one client.
TRUSTED_PROXY_HOPS=0
# Refresh cookie without TLS is impossible; turn this on wherever HTTPS exists.
COOKIE_SECURE=false

# --- client (Vite exposes only VITE_-prefixed variables to the browser) ---
# The client never hardcodes a host: a self-hosted install points this at its own machine.
# Empty means "same origin", which is what development uses: the Vite dev server proxies
# /auth and /health to the API so the httpOnly refresh cookie is actually sent. In
# production, where the client is served from its own host, put the API origin here.
VITE_SERVER_URL=
# Where the dev server proxies those paths.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# --- infrastructure (docker compose reads these; the server does not use them yet) ---
POSTGRES_USER=voreli
POSTGRES_PASSWORD=voreli
POSTGRES_DB=voreli
POSTGRES_PORT=5432
DATABASE_URL=postgresql://voreli:voreli@localhost:5432/voreli?schema=public
# Separate database for the test run, so `pnpm test` never touches development data.
DATABASE_URL_TEST=postgresql://voreli:voreli@localhost:5432/voreli_test?schema=public

# Every host port here is overridable: a machine that already runs one of these
# services locally just shifts the port in its own .env.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=voreli
S3_SECRET_KEY=voreli-secret
S3_BUCKET=voreli
