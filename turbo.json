{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",

  // Turborepo runs tasks in a filtered environment: a variable a task is not told about is
  // simply absent, no matter that the shell had it. Everything a task reads is declared
  // here, which also makes it part of the cache key — a build with a different API URL is
  // correctly treated as a different build.
  "globalEnv": ["NODE_ENV", "CI"],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_SERVER_URL", "VITE_DEV_PROXY_TARGET"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "JWT_SECRET",
        "CORS_ORIGIN",
        "COOKIE_SECURE",
        "REDIS_URL",
        "PORT",
        "ACCESS_TOKEN_TTL",
        "REFRESH_TOKEN_TTL_DAYS",
        "PERMISSION_CACHE_TTL",
        "TRUSTED_PROXY_HOPS",
        "VITE_SERVER_URL"
      ]
    }
  }
}
