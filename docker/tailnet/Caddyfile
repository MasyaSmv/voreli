{
	auto_https off
	servers 127.0.0.1:18080 {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/8
				fallback_policy reject
			}
		}
	}
}

:18080 {
	bind 127.0.0.1

	@api path /auth* /health* /servers* /channels* /categories* /roles* /members* /messages* /invites* /users* /attachments* /uploads* /relationships* /friend-requests* /friends* /blocks* /direct-conversations* /socket.io*
	handle @api {
		reverse_proxy 127.0.0.1:13000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

:19080 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:19000
}
