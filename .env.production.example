# Copy to .env.production on the deployment host; never commit the filled file.
# The two hostnames must resolve to this host before Caddy can get certificates.
APP_DOMAIN=chat.example.com
S3_DOMAIN=storage.example.com
RELEASE_TAG=replace-with-git-commit
SERVER_PORT=3000

POSTGRES_USER=voreli
POSTGRES_PASSWORD=replace-with-unique-random-password
POSTGRES_DB=voreli
# URL-encode special characters in the password. Must point to loopback, not Compose DNS.
DATABASE_URL=postgresql://voreli:replace-with-unique-random-password@127.0.0.1:5432/voreli?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
S3_ACCESS_KEY=replace-with-unique-access-key
S3_SECRET_KEY=replace-with-unique-random-secret
S3_BUCKET=voreli
MEDIASOUP_ANNOUNCED_IP=replace-with-public-ip
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
